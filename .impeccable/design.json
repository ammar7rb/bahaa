  "narrative": {
    "northStar": "Sigma Care",
    "overview": "The vendor workspace extends the established Sigma Care identity into daily operations: cool paper, white containment, medical blue actions, and readable Arabic typography. The shell uses one labeled sidebar and a quiet header so business data and the next action carry the hierarchy.\n\nThis root document applies only to the vendor workspace. Source authority is `public/assets/back-end/css/vendor-workspace.css`, loaded after the inherited vendor shell and `vendor-account.css`. The user approved this surface change on 7 October 2026 in PRODUCT.md. The storefront retains its separate authority at `resources/themes/theme_sigma_care/DESIGN.md`; that file's earlier merchant-preservation statements describe its original storefront scope. This document does not redesign the administration shell, Default, or Aster.",
    "keyCharacteristics": [
      "Fixed light appearance inherited from Sigma Care.",
      "Locally served Arabic typography and logical RTL alignment.",
      "A single labeled sidebar with a mobile drawer.",
      "Flat cards, pale active rows, and elevated previews.",
      "Visible focus and touch controls of at least 44px."
    ],
    "rules": [
      {
        "name": "The Care Palette Rule",
        "body": "Keep this workspace light and use the inherited fixed Care palette; preserve semantic operational status colors.",
        "section": "colors"
      },
      {
        "name": "The Single Sidebar Rule",
        "body": "Keep one labeled navigation hierarchy; use its drawer representation on mobile rather than adding a second icon rail.",
        "section": "layout"
      },
      {
        "name": "The Overlay Depth Rule",
        "body": "Reserve the strong ambient shadow for floating previews; everyday operational cards remain flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep the vendor workspace light and preserve SIGMA's factual logo.",
      "**Do** use local VendorCare typography, logical RTL spacing, and wrapping Arabic labels.",
      "**Do** retain flat everyday cards, clear borders, pale active rows, and visible keyboard focus.",
      "**Do** maintain 44px touch controls and the single sidebar's mobile drawer.",
      "**Do** preserve real counts, statuses, permissions, and explicit acknowledgment actions."
    ],
    "donts": [
      "**Don't** apply this vendor document to the administration shell or other storefront themes.",
      "**Don't** reintroduce a second navigation rail or hover-only operational actions.",
      "**Don't** use decorative elevation on everyday cards or entrance motion that hides content.",
      "**Don't** turn an unread color treatment into an implicit acknowledgment when a page opens."
    ]
  }
