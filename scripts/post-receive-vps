#!/usr/bin/env bash
set -euo pipefail
umask 077
repo=/home/sigma-eg/git/sigma-site.git
target=
while read -r oldrev newrev refname; do
  if [[ "$refname" == refs/heads/main ]]; then target=$newrev; fi
done
[[ -n "$target" ]] || exit 0
if [[ -f "$repo/DEPLOY_DISABLED" ]]; then
  echo 'Automatic deployment is disabled; main was received but production was not changed.'
  exit 0
fi
log="$repo/source-deploy-$target.log"
runner="$repo/source-runner-$target.py"
git --git-dir="$repo" show "$target:scripts/vps/deploy-source.py" > "$runner"
chmod 600 "$runner"
if ! python3 "$runner" "$target" > "$log" 2>&1; then
  echo "DEPLOYMENT FAILED; source retained in main; inspect $log"
  tail -n 8 "$log"
  exit 1
fi
tail -n 1 "$log"
